// Windows application resource file for Glate (generated via CMake configure_file)
#include <windows.h>

// Application icon
IDI_ICON1 ICON "icons/app/glate.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "KtechPit"
            VALUE "FileDescription",  "Glate - Google Translator for Desktop"
            VALUE "FileVersion",      "@GLATE_VERSION@.0"
            VALUE "InternalName",     "glate"
            VALUE "LegalCopyright",   "Copyright (C) 2024 KtechPit"
            VALUE "OriginalFilename", "glate.exe"
            VALUE "ProductName",      "Glate"
            VALUE "ProductVersion",   "@GLATE_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

