/* ============================================================================
   FUSION 2 LIGHT THEME  -  Qt Style Sheet (QSS) for PyQt5 / PySide
   ----------------------------------------------------------------------------
   The light companion to fusion2_dark.qss. NOT an inversion: it's a purpose-
   built light palette (white cards elevated over a soft grey base) with a
   monochrome near-black accent that plays the same role white plays in the
   dark theme. Selector list is identical to the dark sheet so the two are
   drop-in swappable.

   ----------------------------------------------------------------------------
   HOW TO LOAD (PyQt5):
       from PyQt5.QtWidgets import QApplication
       app = QApplication(sys.argv)
       with open("fusion2_light.qss", "r") as f:
           app.setStyleSheet(f.read())

   DYNAMIC PROPERTY VARIANTS (accent buttons, etc.) use Qt property selectors,
   e.g.  btn.setProperty("accent", True).  If you toggle a property AFTER the
   widget is shown, force a restyle:
       btn.style().unpolish(btn); btn.style().polish(btn)

   COLOR PALETTE (for reference - QSS has no variables, values are inline):
       base bg .............. #f5f6f8    sidebar bg ........... #eceef1
       elevated card ........ #ffffff    card hover ........... #f1f2f5
       input bg ............. #ffffff    input hover .......... #f1f2f5
       border / divider ..... #e3e6ea    border strong ........ #d2d6dc
       text ................. #1a1d23    text subdued ......... #5b6472
       text muted ........... #8a92a0    accent (mono dark) ... #1a1d23
       accent hover ......... #2e323a    accent pressed ....... #0e1014
       accent text (on dark). #ffffff    scrollbar thumb ...... rgba(0,0,0,.22)
   ============================================================================ */


/* ====================  GLOBAL / BASE  ==================================== */
* {
    outline: 0;                       /* kill the dotted focus rectangle      */
}

QWidget {
    background-color: #f5f6f8;
    color: #1a1d23;
    /* Fusion 2 ships "Circular"/"Gotham" (proprietary). Closest free options:
       install Montserrat or Inter for the most accurate look. Qt picks the
       first available family from this list.                                  */
    font-family: "Montserrat", "Inter", "Segoe UI", "Noto Sans", "Ubuntu", sans-serif;
    font-size: 13px;
}

QMainWindow,
QDialog {
    background-color: #f5f6f8;
}

/* Tooltip - light chip, dark text */
QToolTip {
    background-color: #ffffff;
    color: #1a1d23;
    border: 1px solid #d2d6dc;
    border-radius: 0px;
    padding: 3px 7px;
    font-size: 12px;
}

/* Generic text helpers - assign via objectName, e.g. lbl.setObjectName("H1") */
QLabel { background-color: transparent; }
QLabel#H1 { font-size: 28px; font-weight: 700; color: #1a1d23; }
QLabel#H2 { font-size: 20px; font-weight: 700; color: #1a1d23; }
QLabel#H3 { font-size: 15px; font-weight: 600; color: #1a1d23; }
QLabel#Subdued  { color: #5b6472; }
QLabel#Muted    { color: #8a92a0; font-size: 11px; }
QLabel#Caption  { color: #5b6472; font-size: 11px; letter-spacing: 1px; }

QLabel:disabled { color: #b0b6bf; }


/* ====================  CARDS / PANELS / FRAMES  ========================== */
/* Apply with frame.setObjectName("Card") for an elevated, rounded surface.
   On a light base the elevation reads from a white fill + hairline border
   (a dark theme can lean on fill alone; a light one needs the edge).         */

   QFrame {
    border: 0px;
}
QFrame#Card {
    background-color: #ffffff;
    border: 1px solid #ebedf0;
    border-radius: 8px;
}
QFrame#Card:hover {
    background-color: #f1f2f5;
}

QFrame#Sidebar,
QWidget#Sidebar {
    background-color: #eceef1;
}

QFrame#TopBar,
QWidget#TopBar {
    background-color: #ffffff;
}

QFrame#NowPlayingBar,
QWidget#NowPlayingBar {
    background-color: #ffffff;
    border-top: 1px solid #e3e6ea;
}

/* Horizontal / vertical rule lines (QFrame set to HLine / VLine) */
QFrame[frameShape="4"] {   /* HLine */
    background-color: #e3e6ea;
    border: none;
    max-height: 1px;
}
QFrame[frameShape="5"] {   /* VLine */
    background-color: #e3e6ea;
    border: none;
    max-width: 1px;
}


/* ====================  BUTTONS  ========================================== */

QPushButton {
    background-color: #e9ebef;
    color: #1a1d23;
    border: none;
    border-radius: 16px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #dee1e6;
    color: #0e1014;
}

QPushButton:pressed {
    background-color: #d2d6dc;
}

QPushButton:checked {
    background-color: #1a1d23;
    color: #ffffff;
}

QPushButton:checked:hover {
    background-color: #2e323a;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #dfe2e7;   /* visibly muted button, not flat against the bg */
    color: #a7adb6;
}

/* ====================  TOOL BUTTONS (icon-only transport/util)  ========== */
QToolButton {
    background-color: transparent;
    color: #5b6472;
    border: none;
    border-radius: 4px;
    padding: 6px;
}
QToolButton:hover   { color: #1a1d23; background-color: rgba(0,0,0,0.06); }
QToolButton:pressed { color: #5b6472; }
QToolButton:checked { color: #1a1d23; }
QToolButton:disabled{ color: #b0b6bf; }
QToolButton::menu-indicator { image: none; }


/* ====================  LINE EDIT (search / inputs)  ====================== */
QLineEdit {
    background-color: #ffffff;
    color: #1a1d23;
    border: 1px solid #dcdfe6;
    border-radius: 16px;       /* match the buttons' pill radius */
    padding: 6px 14px;         /* 6px + 1px border = the button's 7px -> equal height */
    selection-background-color: #1a1d23;
    selection-color: #ffffff;
}
QLineEdit:hover  { background-color: #ffffff; border: 1px solid #c7ccd4; }
QLineEdit:focus  { background-color: #ffffff; border: 1px solid rgba(26,29,35,0.22); }
QLineEdit:disabled {
    background-color: #f0f1f3;
    color: #b0b6bf;
}
QLineEdit[echoMode="2"] { lineedit-password-character: 9679; }  /* password dots */

QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    color: #1a1d23;
    border: 1px solid #e3e6ea;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #1a1d23;
    selection-color: #ffffff;
}

QTextEdit:focus,
QPlainTextEdit:focus { border: 1px solid #e3e6ea; }

/* ====================  COMBO BOX  ======================================= */
/* Mirrors the default QPushButton: subtle translucent fill, pill radius,
   no border in any state (no stray top line ever appears).                   */
QComboBox {
    background-color: rgba(0, 0, 0, 0.05);
    color: #1a1d23;
    border: none;
    border-radius: 16px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
    /* Scrollable list popup that honours maxVisibleItems, so long lists (e.g.
       the language selector) don't span the whole screen height. */
    combobox-popup: 0;
}
QComboBox:hover    { background-color: rgba(0, 0, 0, 0.09); }
QComboBox:on       { background-color: rgba(0, 0, 0, 0.09); }   /* popup open */
QComboBox:focus    { background-color: rgba(0, 0, 0, 0.09); border: none; }
QComboBox:disabled { background-color: rgba(0, 0, 0, 0.03); color: #b0b6bf; }

/* The drop-down region: no frame, no inner box - blends into the pill.        */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    background: transparent;
}
/* Dropdown arrow ? custom SVG chevron.
   Path is absolute (QSS relative paths resolve against the working dir, not the
   .qss file). Place chevron-down.svg in your project root, or edit the path.    */
QComboBox::down-arrow {
    image: url(:/appchrome/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
    margin-right: 12px;
}

/* Popup list. The square box behind this rounded card is the popup's own
   window frame - removed in Python (round_combo_popup), not here.             */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a1d23;
    border: 1px solid #dcdfe6;
    border-radius: 10px;
    padding: 6px;          /* breathing room for the first/last rows */
    outline: 0;
}
QComboBox QAbstractItemView::item {
    padding: 2px 10px;     /* row height enforced by NoFocusDelegate (no clip) */
    margin: 1px 4px;
    border-radius: 6px;
    color: #5b6472;        /* subdued; darkens to #1a1d23 on hover/selected */
    background-color: transparent;
}
QComboBox QAbstractItemView::item:hover    { background-color: #eceef1; color: #1a1d23; }
QComboBox QAbstractItemView::item:selected { background-color: #e2e5ea; color: #1a1d23; }


/* ====================  SPIN BOX  ======================================== */

QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background-color: #ffffff;
    color: #1a1d23;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    padding: 6px 24px 6px 8px;
    selection-background-color: #1a1d23;
    selection-color: #ffffff;
}

QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover {
    border: 1px solid #c7ccd4;
}

QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus {
    border: 1px solid #1a1d23;
}

/* Buttons */

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    background: transparent;
    border: none;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

/* SVG Chevron Icons */

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/appchrome/icons/chevron_up_spinbox.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/appchrome/icons/chevron_down_spinbox.svg);
    width: 10px;
    height: 10px;
}

/* Hover */

QSpinBox::up-arrow:hover,
QDoubleSpinBox::up-arrow:hover {
    image: url(:/appchrome/icons/chevron_up_spinbox.svg);
}

QSpinBox::down-arrow:hover,
QDoubleSpinBox::down-arrow:hover {
    image: url(:/appchrome/icons/chevron_down_spinbox.svg);
}

/* ====================  CHECK BOX  ======================================= */
QCheckBox {
    color: #1a1d23;
    spacing: 8px;
    background: transparent;
}
QCheckBox:disabled { color: #b0b6bf; }


/* ====================  RADIO BUTTON  ==================================== */
QRadioButton {
    color: #1a1d23;
    spacing: 8px;
    background: transparent;
}
QRadioButton:disabled { color: #b0b6bf; }


/* ====================  SLIDER (progress / volume scrubbers)  ============= */
QSlider:horizontal { min-height: 22px; background: transparent; }
QSlider::groove:horizontal {
    height: 6px;
    background: #dcdfe6;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {     /* played / filled portion */
    background: #8a92a0;
    border-radius: 3px;
}
QSlider::add-page:horizontal {     /* remaining portion */
    background: #dcdfe6;
    border-radius: 3px;
}
QSlider::handle:horizontal {       /* visible round knob */
    background: #ffffff;
    border: 1px solid #c7ccd4;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover   { border-color: #1a1d23; }
QSlider::handle:horizontal:pressed { border-color: #1a1d23; }

QSlider:vertical { min-width: 22px; background: transparent; }
QSlider::groove:vertical { width: 6px; background: #dcdfe6; border-radius: 3px; }
QSlider::sub-page:vertical { background: #dcdfe6; border-radius: 3px; }
QSlider::add-page:vertical { background: #8a92a0; border-radius: 3px; }
QSlider::handle:vertical {
    background: #ffffff; border: 1px solid #c7ccd4; width: 14px; height: 14px;
    margin: 0 -6px; border-radius: 8px;
}
QSlider::handle:vertical:hover { border-color: #1a1d23; }


/* ====================  SCROLL BARS (ROUNDED)  ====================== */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: rgba(0,0,0,0.22);
    min-height: 40px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: rgba(0,0,0,0.34); }
QScrollBar::handle:vertical:pressed { background: rgba(0,0,0,0.48); }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; background: transparent; border: none; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: rgba(0,0,0,0.22);
    min-width: 40px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover { background: rgba(0,0,0,0.34); }
QScrollBar::handle:horizontal:pressed { background: rgba(0,0,0,0.48); }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; background: transparent; border: none; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: transparent; }

QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QAbstractScrollArea { background: transparent; border: none; }
QAbstractScrollArea::corner { background: transparent; }

/* MainWindow splitter handle: visible by default so the pane divider reads as a line. */
QSplitter#paneSplitter::handle {
    background-color: rgba(0, 0, 0, 0.05);
}
QSplitter#paneSplitter::handle:hover {
    background-color: rgba(0, 0, 0, 0.10);
}


/* ====================  LIST / TREE / TABLE VIEWS  ======================= */
QListView,
QTreeView,
QListWidget,
QTreeWidget {
    background-color: #f5f6f8;
    color: #1a1d23;
    border: none;
    outline: 0;
    show-decoration-selected: 1;
}
QListView::item,
QTreeView::item,
QListWidget::item,
QTreeWidget::item {
    padding: 4px 10px;
    border-radius: 4px;
    color: #5b6472;
}
QListView::item:hover,
QTreeView::item:hover,
QListWidget::item:hover,
QTreeWidget::item:hover { background-color: #eceef1; color: #1a1d23; }

QListView::item:selected,
QTreeView::item:selected,
QListWidget::item:selected,
QTreeWidget::item:selected { background-color: #e2e5ea; color: #1a1d23; }

QListView::item:disabled,
QListWidget::item:disabled { color: #b0b6bf; }

QTreeView::branch { background: transparent; }

/* Sidebar nav variant - flatten selection highlight, dark text when active.
   Give the nav list  setObjectName("Nav")                                    */
QListWidget#Nav { background-color: #eceef1; padding: 4px; }
QListWidget#Nav::item {
    padding: 10px 14px;
    border-radius: 6px;
    color: #5b6472;
    font-weight: 600;
}
QListWidget#Nav::item:hover    { color: #1a1d23; background-color: transparent; }
QListWidget#Nav::item:selected { color: #1a1d23; background-color: #dcdfe6; }


/* Table views */
QTableView,
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f7f8fa;
    color: #1a1d23;
    gridline-color: transparent;
    border: none;
    outline: 0;
    selection-background-color: #e2e5ea;
    selection-color: #1a1d23;
}
QTableView::item,
QTableWidget::item { padding: 8px 10px; border: none; }
QTableView::item:hover,
QTableWidget::item:hover    { background-color: #f1f2f5; }
QTableView::item:selected,
QTableWidget::item:selected { background-color: #e2e5ea; color: #1a1d23; }

QHeaderView { background-color: transparent; border: none; }
QHeaderView::section {
    background-color: #f5f6f8;
    color: #5b6472;
    border: none;
    border-bottom: 1px solid #e3e6ea;
    padding: 8px 10px;
    font-size: 11px;
    font-weight: 600;
}
QHeaderView::section:hover { color: #1a1d23; }
QTableCornerButton::section { background-color: #f5f6f8; border: none; }


/* ====================  TAB WIDGET  ====================================== */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #e3e6ea;
    top: -1px;
    background: transparent;
}
QTabBar { qproperty-drawBase: 0; background: transparent; }
QTabBar::tab {
    background: transparent;
    color: #5b6472;
    padding: 10px 16px;
    margin-right: 4px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}
QTabBar::tab:hover    { color: #1a1d23; }
QTabBar::tab:selected { color: #1a1d23; border-bottom: 2px solid #1a1d23; }
QTabBar::tab:disabled { color: #b0b6bf; }


/* ====================  PROGRESS BAR  ==================================== */
QProgressBar {
    background-color: #dcdfe6;
    color: #1a1d23;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    font-size: 11px;
}
QProgressBar::chunk {
    background-color: #1a1d23;
    border-radius: 3px;
}


/* ====================  GROUP BOX  ======================================= */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
    margin-top: 9px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    background-color: #f5f6f8;
    color: #1a1d23;
}


/* ====================  MENUS  =========================================== */
QMenuBar {
    background-color: #f5f6f8;
    color: #5b6472;
    border: none;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected { background-color: #e4e7ec; color: #1a1d23; }
QMenuBar::item:pressed  { background-color: #e4e7ec; }

QMenu {
    background-color: #ffffff;
    color: #1a1d23;
    border: 1px solid #e3e6ea;
    border-radius: 6px;
    padding: 6px;
}
QMenu::item {
    background: transparent;
    padding: 8px 28px 8px 14px;
    border-radius: 4px;
}
QMenu::item:selected { background-color: #eceef1; color: #1a1d23; }
QMenu::item:disabled { color: #b0b6bf; }
QMenu::separator {
    height: 1px;
    background: #e3e6ea;
    margin: 6px 8px;
}
QMenu::indicator { width: 16px; height: 16px; left: 6px; }
QMenu::icon { padding-left: 6px; }


/* ====================  SPLITTER  ======================================== */
/* Invisible by default (the panes meet over a thin gap); a subtle tint on hover
   hints it's draggable. Width is set in code via setHandleWidth(). */
QSplitter::handle          { background-color: transparent; }
QSplitter::handle:hover    { background-color: rgba(0, 0, 0, 0.08); }

/* Thin themed separators between toolbars and content (see MainWindow). */
QFrame#toolbarSeparator    { background-color: #e3e6ea; border: none; }


/* ====================  STATUS BAR  ===================================== */
QStatusBar {
    background-color: #ffffff;
    color: #5b6472;
    border-top: 1px solid #e3e6ea;
}
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; width: 0; height: 0; }


/* ====================  DIALOG BUTTON BOX  ============================== */
QDialogButtonBox QPushButton { min-width: 80px; }


/* ====================  MISC  =========================================== */
QToolBar {
    background-color: #f5f6f8;
    border: none;
    border-bottom: 1px solid #e3e6ea;
    spacing: 4px;
    padding: 4px;
}
QToolBar::separator { background: #e3e6ea; width: 1px; margin: 4px 6px; }

QCalendarWidget QWidget { background-color: #ffffff; }
QCalendarWidget QAbstractItemView:enabled { color: #1a1d23; selection-background-color: #1a1d23; selection-color: #ffffff; }

/* End of fusion2_light.qss */

/* ── Added: menu-button chevron + preset panel card ── */
QPushButton::menu-indicator {
    image: url(:/appchrome/icons/chevron-down.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px; height: 12px;
    right: 10px;
}
#presetStackedWidget {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}

/* Icon-only buttons. A content-sized icon-only QPushButton won't take the pill
   border-radius in this Qt, so it renders as a hard square box. ThemeController
   tags every icon-only QPushButton with the dynamic property iconOnly=true; we
   render those FLAT (no box) with a subtle rounded hover instead. Text buttons
   round normally via the default QPushButton rule above. */
QPushButton[iconOnly="true"] {
    background: transparent;
    border: none;
    border-radius: 14px;
    padding: 6px;
    min-width: 0;
}
QPushButton[iconOnly="true"]:hover    { background: rgba(0,0,0,0.06); }
QPushButton[iconOnly="true"]:pressed  { background: rgba(0,0,0,0.10); }
QPushButton[iconOnly="true"]:checked  { background: rgba(0,0,0,0.12); }
QPushButton[iconOnly="true"]:disabled { background: transparent; }
