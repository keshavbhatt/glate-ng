/* ============================================================================
   FUSION 2 LIGHT THEME  -  Qt Style Sheet (QSS) for PyQt5 / PySide
   ----------------------------------------------------------------------------
   The light companion to fusion2_dark.qss. NOT an inversion: it's a purpose-
   built light palette (white cards elevated over a soft grey base) with a
   monochrome near-black accent that plays the same role white plays in the
   dark theme. Selector list is identical to the dark sheet so the two are
   drop-in swappable.

   ----------------------------------------------------------------------------
   HOW TO LOAD (PyQt5):
       from PyQt5.QtWidgets import QApplication
       app = QApplication(sys.argv)
       with open("fusion2_light.qss", "r") as f:
           app.setStyleSheet(f.read())

   DYNAMIC PROPERTY VARIANTS (accent buttons, etc.) use Qt property selectors,
   e.g.  btn.setProperty("accent", True).  If you toggle a property AFTER the
   widget is shown, force a restyle:
       btn.style().unpolish(btn); btn.style().polish(btn)

   COLOR PALETTE (for reference - QSS has no variables, values are inline):
       base bg .............. #F4F5F7    sidebar bg ........... #ECEEF2
       elevated card ........ #ffffff    card hover ........... #ECEEF2
       input bg ............. #ffffff    input hover .......... #ECEEF2
       border / divider ..... #DEE1E7    border strong ........ #D0D4DB
       text ................. #16181D    text subdued ......... #5C6573
       text muted ........... #8A929E    accent (mono dark) ... #16181D
       accent hover ......... #2e323a    accent pressed ....... #0e1014
       accent text (on dark). #ffffff    scrollbar thumb ...... rgba(0,0,0,.22)
   ============================================================================ */


/* ====================  GLOBAL / BASE  ==================================== */
* {
    outline: 0;                       /* kill the dotted focus rectangle      */
}

QWidget {
    background-color: #F4F5F7;
    color: #16181D;
}

QMainWindow,
QDialog {
    background-color: #F4F5F7;
}

/* Tooltip - light chip, dark text */
QToolTip {
    background-color: #ffffff;
    color: #16181D;
    border: 1px solid #D0D4DB;
    border-radius: 0px;
    padding: 3px 7px;
}

/* Generic text helpers - assign via objectName, e.g. lbl.setObjectName("H1") */
QLabel { background-color: transparent; }
QLabel#H1 { font-weight: 700; color: #16181D; }
QLabel#H2 { font-weight: 700; color: #16181D; }
QLabel#H3 { font-weight: 600; color: #16181D; }
QLabel#Subdued  { color: #5C6573; }
QLabel#Muted    { color: #8A929E; }
QLabel#Caption  { color: #5C6573; letter-spacing: 1px; }

QLabel:disabled { color: #C5CAD3; }


/* ====================  CARDS / PANELS / FRAMES  ========================== */
/* Apply with frame.setObjectName("Card") for an elevated, rounded surface.
   On a light base the elevation reads from a white fill + hairline border
   (a dark theme can lean on fill alone; a light one needs the edge).         */

   QFrame {
    border: 0px;
}
QFrame#Card {
    background-color: #ffffff;
    border: 1px solid #ECEEF2;
    border-radius: 8px;
}
QFrame#Card:hover {
    background-color: #ECEEF2;
}

QFrame#Sidebar,
QWidget#Sidebar {
    background-color: #ECEEF2;
}

QFrame#TopBar,
QWidget#TopBar {
    background-color: #ffffff;
}

QFrame#NowPlayingBar,
QWidget#NowPlayingBar {
    background-color: #ffffff;
    border-top: 1px solid #DEE1E7;
}

/* Horizontal / vertical rule lines (QFrame set to HLine / VLine) */
QFrame[frameShape="4"] {   /* HLine */
    background-color: #DEE1E7;
    border: none;
    max-height: 1px;
}
QFrame[frameShape="5"] {   /* VLine */
    background-color: #DEE1E7;
    border: none;
    max-width: 1px;
}


/* ====================  BUTTONS  ========================================== */

/* As .btn in DOCS/mocks/mock.css: 6 px corners, a hairline border, normal weight.
   (A radius over half the height made Qt draw square corners.)                */
QPushButton {
    background-color: #ffffff;
    color: #16181D;
    border: 1px solid #DEE1E7;
    border-radius: 8px;
    padding: 5px 14px;
    font-weight: normal;
}

QPushButton:hover {
    background-color: #ECEEF2;
    color: #0e1014;
}

QPushButton:pressed {
    background-color: #DEE1E7;
}

QPushButton:checked {
    background-color: #16181D;
    color: #ffffff;
}

QPushButton:checked:hover {
    background-color: #2e323a;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #ECEEF2;   /* visibly muted button, not flat against the bg */
    border-color: #DEE1E7;
    color: #8A929E;
}

/* ====================  TOOL BUTTONS (icon-only transport/util)  ========== */
QToolButton {
    background-color: transparent;
    color: #5C6573;
    border: none;
    border-radius: 4px;
    padding: 6px;
}
QToolButton:hover   { color: #16181D; background-color: rgba(0,0,0,0.06); }
QToolButton:pressed { color: #5C6573; }
QToolButton:checked { color: #16181D; }
QToolButton:disabled{ color: #C5CAD3; }
QToolButton::menu-indicator { image: none; }


/* ====================  LINE EDIT (search / inputs)  ====================== */
QLineEdit {
    background-color: #ffffff;
    color: #16181D;
    border: 1px solid #DEE1E7;
    border-radius: 8px;        /* as .input in DOCS/mocks/mock.css, like the buttons */
    padding: 5px 10px;
    selection-background-color: #16181D;
    selection-color: #ffffff;
}
QLineEdit:hover  { background-color: #ffffff; border: 1px solid #C5CAD3; }
QLineEdit:focus  { background-color: #ffffff; border: 1px solid rgba(26,29,35,0.22); }
QLineEdit:disabled {
    background-color: #ECEEF2;
    color: #C5CAD3;
}
QLineEdit[echoMode="2"] { lineedit-password-character: 9679; }  /* password dots */

/* ====================  COMBO BOX  ======================================= */
/* Mirrors the default QPushButton: subtle translucent fill, pill radius,
   no border in any state (no stray top line ever appears).                   */
QComboBox {
    background-color: rgba(0, 0, 0, 0.05);
    color: #16181D;
    border: none;
    border-radius: 16px;
    padding: 7px 16px;
    font-weight: 600;
    /* Scrollable list popup that honours maxVisibleItems, so long lists (e.g.
       the language selector) don't span the whole screen height. */
    combobox-popup: 0;
}
QComboBox:hover    { background-color: rgba(0, 0, 0, 0.09); }
QComboBox:on       { background-color: rgba(0, 0, 0, 0.09); }   /* popup open */
QComboBox:focus    { background-color: rgba(0, 0, 0, 0.09); border: none; }
QComboBox:disabled { background-color: rgba(0, 0, 0, 0.03); color: #C5CAD3; }

/* The drop-down region: no frame, no inner box - blends into the pill.        */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    background: transparent;
}
/* Dropdown arrow ? custom SVG chevron.
   Path is absolute (QSS relative paths resolve against the working dir, not the
   .qss file). Place chevron-down.svg in your project root, or edit the path.    */
QComboBox::down-arrow {
    image: url(:/appchrome/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
    margin-right: 12px;
}

/* Popup list. The square box behind this rounded card is the popup's own
   window frame - removed in Python (round_combo_popup), not here.             */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #16181D;
    border: 1px solid #DEE1E7;
    border-radius: 10px;
    padding: 6px;          /* breathing room for the first/last rows */
    outline: 0;
}
QComboBox QAbstractItemView::item {
    padding: 2px 10px;     /* row height enforced by NoFocusDelegate (no clip) */
    margin: 1px 4px;
    border-radius: 8px;
    color: #5C6573;        /* subdued; darkens to #16181D on hover/selected */
    background-color: transparent;
}
QComboBox QAbstractItemView::item:hover    { background-color: #ECEEF2; color: #16181D; }
QComboBox QAbstractItemView::item:selected { background-color: #DEE1E7; color: #16181D; }


/* ====================  SPIN BOX  ======================================== */

QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background-color: #ffffff;
    color: #16181D;
    border: 1px solid #DEE1E7;
    border-radius: 8px;
    padding: 6px 24px 6px 8px;
    selection-background-color: #16181D;
    selection-color: #ffffff;
}

QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover {
    border: 1px solid #C5CAD3;
}

QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus {
    border: 1px solid #16181D;
}

/* Buttons */

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    background: transparent;
    border: none;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

/* SVG Chevron Icons */

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/appchrome/icons/chevron_up_spinbox.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/appchrome/icons/chevron_down_spinbox.svg);
    width: 10px;
    height: 10px;
}

/* Hover */

QSpinBox::up-arrow:hover,
QDoubleSpinBox::up-arrow:hover {
    image: url(:/appchrome/icons/chevron_up_spinbox.svg);
}

QSpinBox::down-arrow:hover,
QDoubleSpinBox::down-arrow:hover {
    image: url(:/appchrome/icons/chevron_down_spinbox.svg);
}

/* ====================  CHECK BOX  ======================================= */
QCheckBox {
    color: #16181D;
    spacing: 8px;
    background: transparent;
}
QCheckBox:disabled { color: #C5CAD3; }


/* ====================  RADIO BUTTON  ==================================== */
QRadioButton {
    color: #16181D;
    spacing: 8px;
    background: transparent;
}
QRadioButton:disabled { color: #C5CAD3; }


/* ====================  SLIDER (progress / volume scrubbers)  ============= */
QSlider:horizontal { min-height: 22px; background: transparent; }
QSlider::groove:horizontal {
    height: 6px;
    background: #DEE1E7;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {     /* played / filled portion */
    background: #8A929E;
    border-radius: 3px;
}
QSlider::add-page:horizontal {     /* remaining portion */
    background: #DEE1E7;
    border-radius: 3px;
}
QSlider::handle:horizontal {       /* visible round knob */
    background: #ffffff;
    border: 1px solid #C5CAD3;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover   { border-color: #16181D; }
QSlider::handle:horizontal:pressed { border-color: #16181D; }

QSlider:vertical { min-width: 22px; background: transparent; }
QSlider::groove:vertical { width: 6px; background: #DEE1E7; border-radius: 3px; }
QSlider::sub-page:vertical { background: #DEE1E7; border-radius: 3px; }
QSlider::add-page:vertical { background: #8A929E; border-radius: 3px; }
QSlider::handle:vertical {
    background: #ffffff; border: 1px solid #C5CAD3; width: 14px; height: 14px;
    margin: 0 -6px; border-radius: 8px;
}
QSlider::handle:vertical:hover { border-color: #16181D; }


/* ====================  SCROLL BARS (ROUNDED)  ====================== */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: rgba(0,0,0,0.22);
    min-height: 40px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: rgba(0,0,0,0.34); }
QScrollBar::handle:vertical:pressed { background: rgba(0,0,0,0.48); }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; background: transparent; border: none; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: rgba(0,0,0,0.22);
    min-width: 40px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover { background: rgba(0,0,0,0.34); }
QScrollBar::handle:horizontal:pressed { background: rgba(0,0,0,0.48); }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; background: transparent; border: none; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: transparent; }

QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QAbstractScrollArea { background: transparent; }
QAbstractScrollArea::corner { background: transparent; }

QAbstractItemView {
    background-color: #ffffff;
    color: #16181D;
    border: 1px solid #DEE1E7;
    outline: 0;
}

QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    color: #16181D;
    border: 1px solid #DEE1E7;
    padding: 8px;
    border-radius: 4px;
    selection-background-color: #16181D;
    selection-color: #ffffff;
}
QTextEdit:focus,
QPlainTextEdit:focus { border: 1px solid #DEE1E7; }
QTextEdit#src1,
QTextEdit#src2 {
    padding-left: 4px;
    padding-right: 4px;
}

/* ====================  LIST / TREE / TABLE VIEWS  ======================= */
QListView,
QTreeView,
QListWidget,
QTreeWidget {
    show-decoration-selected: 1;
}
QListView::item,
QTreeView::item,
QListWidget::item,
QTreeWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
    color: #5C6573;
}
QListView::item:hover,
QTreeView::item:hover,
QListWidget::item:hover,
QTreeWidget::item:hover { background-color: #ECEEF2; color: #16181D; }

QListView::item:selected,
QTreeView::item:selected,
QListWidget::item:selected,
QTreeWidget::item:selected { background-color: #DEE1E7; color: #16181D; }

QListView::item:disabled,
QListWidget::item:disabled { color: #C5CAD3; }

QTreeView::branch { background: transparent; }

/* Sidebar nav variant - flatten selection highlight, dark text when active.
   Give the nav list  setObjectName("Nav")                                    */
QListWidget#Nav { background-color: #ECEEF2; padding: 4px; }
QListWidget#Nav { border: none; }
QListWidget#Nav::item {
    padding: 10px 14px;
    border-radius: 8px;
    color: #5C6573;
    font-weight: 600;
}
QListWidget#Nav::item:hover    { color: #16181D; background-color: transparent; }
QListWidget#Nav::item:selected { color: #16181D; background-color: #DEE1E7; }


/* Table views */
QTableView,
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f7f8fa;
    color: #16181D;
    gridline-color: transparent;
    selection-background-color: #DEE1E7;
    selection-color: #16181D;
}
QTableView::item,
QTableWidget::item { padding: 6px 10px; border: none; }
QTableView::item:hover,
QTableWidget::item:hover    { background-color: #ECEEF2; }
QTableView::item:selected,
QTableWidget::item:selected { background-color: #DEE1E7; color: #16181D; }

QHeaderView { background-color: transparent; border: none; }
QHeaderView::section {
    background-color: #F4F5F7;
    color: #5C6573;
    border: none;
    border-bottom: 1px solid #DEE1E7;
    padding: 8px 10px;
    font-weight: 600;
}
QHeaderView::section:hover { color: #16181D; }
QTableCornerButton::section { background-color: #F4F5F7; border: none; }


/* ====================  TAB WIDGET  ====================================== */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #DEE1E7;
    top: -1px;
    background: transparent;
}
QTabBar { qproperty-drawBase: 0; background: transparent; }
QTabBar::tab {
    background: transparent;
    color: #5C6573;
    padding: 8px 12px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: normal;
}
QTabBar::tab:hover    { color: #16181D; }
QTabBar::tab:selected { color: #16181D; border-bottom: 2px solid #16181D; font-weight: 600; }
QTabBar::tab:disabled { color: #C5CAD3; }


/* ====================  PROGRESS BAR  ==================================== */
QProgressBar {
    background-color: #DEE1E7;
    color: #16181D;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #16181D;
    border-radius: 3px;
}


/* ====================  GROUP BOX  ======================================= */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #DEE1E7;
    border-radius: 8px;
    margin-top: 9px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    background-color: #F4F5F7;
    color: #16181D;
}


/* ====================  MENUS  =========================================== */
QMenuBar {
    background-color: #F4F5F7;
    color: #5C6573;
    border: none;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected { background-color: #ECEEF2; color: #16181D; }
QMenuBar::item:pressed  { background-color: #ECEEF2; }

QMenu {
    background-color: #ffffff;
    color: #16181D;
    border: 1px solid #DEE1E7;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    background: transparent;
    padding: 8px 28px 8px 14px;
    border-radius: 4px;
}
QMenu::item:selected { background-color: #ECEEF2; color: #16181D; }
QMenu::item:disabled { color: #C5CAD3; }
QMenu::separator {
    height: 1px;
    background: #DEE1E7;
    margin: 6px 8px;
}
QMenu::indicator { width: 16px; height: 16px; left: 6px; }
QMenu::icon { padding-left: 6px; }


/* ====================  SPLITTER  ======================================== */
/* Invisible by default (the panes meet over a thin gap); a subtle tint on hover
   hints it's draggable. Width is set in code via setHandleWidth(). */
QSplitter::handle          { background-color: transparent; }
QSplitter::handle:hover    { background-color: rgba(0, 0, 0, 0.08); }

/* Thin themed separators between toolbars and content (see MainWindow). */
QFrame#toolbarSeparator    { background-color: #DEE1E7; border: none; }


/* ====================  STATUS BAR  ===================================== */
QStatusBar {
    background-color: #ffffff;
    color: #5C6573;
    border-top: 1px solid #DEE1E7;
}
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; width: 0; height: 0; }


/* ====================  DIALOG BUTTON BOX  ============================== */
QDialogButtonBox QPushButton { min-width: 80px; }

QFrame#historyCard QPushButton {
    padding: 2px 10px;
    min-height: 0;
}


/* ====================  MISC  =========================================== */
QToolBar {
    background-color: #F4F5F7;
    border: none;
    border-bottom: 1px solid #DEE1E7;
    spacing: 4px;
    padding: 4px;
}
QToolBar::separator { background: #DEE1E7; width: 1px; margin: 4px 6px; }

QCalendarWidget QWidget { background-color: #ffffff; }
QCalendarWidget QAbstractItemView:enabled { color: #16181D; selection-background-color: #16181D; selection-color: #ffffff; }

/* End of fusion2_light.qss */

/* ── Added: menu-button chevron + preset panel card ── */
QPushButton::menu-indicator {
    image: url(:/appchrome/icons/chevron-down.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px; height: 12px;
    right: 10px;
}
#presetStackedWidget {
    background-color: #ffffff;
    border: 1px solid #DEE1E7;
    border-radius: 8px;
}

/* Icon-only buttons. A content-sized icon-only QPushButton won't take the pill
   border-radius in this Qt, so it renders as a hard square box. ThemeController
   tags every icon-only QPushButton with the dynamic property iconOnly=true; we
   render those FLAT (no box) with a subtle rounded hover instead. Text buttons
   round normally via the default QPushButton rule above. */
QPushButton[iconOnly="true"] {
    background: transparent;
    border: none;
    border-radius: 14px;
    padding: 6px;
    min-width: 0;
}
QPushButton[iconOnly="true"]:hover    { background: rgba(0,0,0,0.06); }
QPushButton[iconOnly="true"]:pressed  { background: rgba(0,0,0,0.10); }
QPushButton[iconOnly="true"]:checked  { background: rgba(0,0,0,0.12); }
QPushButton[iconOnly="true"]:disabled { background: transparent; }

/* "More apps from Ktechpit" cards (modules/KtechpitApps): a panel with a hairline. */
QFrame#ktechpitAppCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE1E7;
    border-radius: 12px;
}
QFrame#ktechpitAppCard:hover { border-color: #C5CAD3; }
